# VetroLog Open Source Environment Configuration Template
# Copy this file to .env and configure with your credentials.
# Real credentials should NEVER be committed to Git.

# Google Analytics 4 (GA4 Measurement Protocol)
# Leave as DEMO or empty to run in local test mode (zero analytics sent)
VETROLOG_GA_MEASUREMENT_ID=DEMO_GA_MEASUREMENT_ID_REPLACE_ME
VETROLOG_GA_API_SECRET=DEMO_GA_API_SECRET_REPLACE_ME

# Google OAuth 2.0 Credentials
# Create at https://console.cloud.google.com/apis/credentials
# Authorized JavaScript Origins: http://localhost:8787, http://127.0.0.1:8787
# Authorized Redirect URIs: http://localhost:8787/api/auth/google/callback, http://127.0.0.1:8787/api/auth/google/callback
VETROLOG_GOOGLE_CLIENT_ID=DEMO_GOOGLE_CLIENT_ID_REPLACE_ME.apps.googleusercontent.com
VETROLOG_GOOGLE_CLIENT_SECRET=DEMO_GOOGLE_CLIENT_SECRET_REPLACE_ME

