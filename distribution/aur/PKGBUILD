pkgname=vetrolog-bin
pkgver=1.5.0
pkgrel=1
pkgdesc="High-performance desktop SQLite database inspector for mobile developers (Flutter, Android, React Native)"
arch=('x86_64')
url="https://vetro.hifzio.com"
license=('MIT')
depends=('gtk3' 'webkit2gtk')
optdepends=('android-tools: For ADB device connectivity')
provides=('vetrolog')
conflicts=('vetrolog')
source_x86_64=("https://github.com/Tanvirul-swe/vetrolog/releases/download/v${pkgver}/VetroLog-Linux-x64.tar.gz"
               "vetrolog.desktop::https://raw.githubusercontent.com/Tanvirul-swe/vetrolog/main/distribution/desktop/vetrolog.desktop"
               "vetrolog.png::https://raw.githubusercontent.com/Tanvirul-swe/vetrolog/main/build/appicon.png")
sha256sums_x86_64=('1bd97d4008c55d6b40404b28d1e228b10183c760d66360737489c5fec4a53253'
                   'SKIP'
                   'SKIP')

package() {
    install -Dm755 "${srcdir}/vetrolog" "${pkgdir}/usr/bin/vetrolog"
    install -Dm644 "${srcdir}/vetrolog.desktop" "${pkgdir}/usr/share/applications/vetrolog.desktop"
    install -Dm644 "${srcdir}/vetrolog.png" "${pkgdir}/usr/share/icons/hicolor/512x512/apps/vetrolog.png"
}
